{
  "name": "note-for-approval",
  "version": "1.0.0",
  "description": "Welcome to your new CAP project.",
  "main": "index.js",
  "scripts": {
    "start": "cds-serve",
    "test": "node --test test/*.test.js",
    "watch-nfa-fiori": "cds watch --profile hybrid --open nfafiori/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy note-for-approval --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "cds": {
    "requires": {
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "dummy"
        }
      }
    }
  },
  "dependencies": {
    "@cap-js/attachments": "^3.13.2",
    "@cap-js/hana": "^3",
    "@cap-js/sqlite": "^3.0.2",
    "@sap-cloud-sdk/connectivity": "^4.8.0",
    "@sap-cloud-sdk/http-client": "^4.8.0",
    "@sap-cloud-sdk/resilience": "^4.8.0",
    "@sap/cds": "^10.0.3",
    "@sap/xssec": "^4.15.0",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.5.9",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "sqlite": "^5.1.1"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10.0.5",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "workspaces": [
    "app/*"
  ]
}
