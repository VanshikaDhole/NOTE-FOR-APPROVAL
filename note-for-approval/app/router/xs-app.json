{
  "welcomeFile": "/nfafiori/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/v4/nfa/(.*)$",
      "target": "/odata/v4/nfa/$1",
      "destination": "srv-api",
      "csrfProtection": false
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "none"
    }
  ]
}
